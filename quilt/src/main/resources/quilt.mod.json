{
  "schema_version": 1,
  "quilt_loader": {
    "group": "${group}",
    "id": "${mod_id}",
    "version": "${version}",
    "metadata": {
      "name": "${mod_name}",
      "description": "${description}",
      "contributors": {
        "${mod_author}": "Owner"
      },
      "license": "${license}",
      "icon": "icon.png"
    },
    "intermediate_mappings": "net.fabricmc:intermediary",
    "entrypoints": {
      "init": [
        "com.villagerai.quilt.VillagerAIQuilt"
      ],
      "main": [
        "com.villagerai.quilt.VillagerAIQuilt"
      ],
      "client_init": [
        "com.villagerai.quilt.client.VillagerAIQuiltClient"
      ],
      "client": [
        "com.villagerai.quilt.client.VillagerAIQuiltClient"
      ]
    },
    "depends": [
      {
        "id": "quilt_loader",
        "versions": ">=${quilt_loader_version}"
      },
      {
        "id": "minecraft",
        "versions": ">=${minecraft_version}"
      }
    ]
  },
  "mixin": [
    "${mod_id}.mixins.json"
  ]
}
